@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LANDSCAPE()

title Diagrama de Contexto - TADSXandria

Person(usuario, "Usuário comum", "Usuário autenticado que pode interagir com os projetos publicados")
Person(orientador, "Orientador", "Docente responsável por cadastrar os projetos")
Person(orientando, "Orientando", "Discente responsável pelo desenvolvimento e gerenciamento do projeto")
Person(visitante, "Visitante", "Pessoa que acessa a plataforma sem realizar login")

System(system, "TADSXandria", "Repositório público de trabalhos e projetos desenvolvidos pelos discentes do curso TADS do IFRN CNAT")

System_Ext(api_suap, "API SUAP", "API externa utilizada para autenticação dos usuários por meio das credenciais institucionais")
System_Ext(api_google, "API Google", "API externa utilizada para autenticação por meio de uma conta Google")
System_Ext(api_github, "API GitHub", "API externa utilizada para autenticação por meio de uma conta GitHub")

Rel(orientador, system, "Cadastra projetos")
Rel(orientando, system, "Gerencia projetos")
Rel(visitante, system, "Pesquisa e visualiza projetos")
Rel(usuario, system, "Pesquisa, visualiza e interage com projetos")

Rel(system, api_suap, "Autentica usuários")
Rel(system, api_google, "Autentica usuários")
Rel(system, api_github, "Autentica usuários")

@enduml